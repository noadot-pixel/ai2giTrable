rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 좋아요/댓글 수(카운터)만 바꾸는 갱신인지 확인.
    // 글 작성자가 아닌 사용자도 카운터만은 바꿀 수 있어야 한다.
    function onlyCounterChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['likes', 'comments']);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid || isAdmin() || onlyCounterChange());
      allow delete: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid || isAdmin());

      // 댓글: 누구나 읽기, 로그인한 사용자만 작성(본인 uid로만), 삭제는
      // 댓글 작성자 / 게시글 작성자 / 관리자만 가능. 수정은 없음.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 500;
        allow update: if false;
        allow delete: if isSignedIn() &&
          (resource.data.authorUid == request.auth.uid ||
           isAdmin() ||
           get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid);
      }

      // 좋아요: 문서 id = 좋아요한 사용자의 uid. 본인 것만 읽고/만들고/지울 수 있음.
      match /likes/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /postLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      // 스크랩: 본인만 읽고 쓸 수 있는 개인 목록. 문서 id = 스크랩한 글의 id.
      match /scraps/{postId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
